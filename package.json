{
  "name": "erp-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace apps/api run dev",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run build --workspace apps/api && node --test apps/api/dist/*.test.js && npm test --workspace apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom",
    "react-native": "$react-native",
    "@types/react": "$@types/react"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@types/react": "~19.1.10"
  }
}
